rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{id} {
      allow read: if true;
      // Clients must submit with status=pending; verified/verificationStatus set by admin SDK only
      allow create: if request.resource.data.status == 'pending'
        && !('verified' in request.resource.data)
        && !('verificationStatus' in request.resource.data);
      // Allow incrementing the views counter only
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }
    match /claims/{id} {
      allow create: if true;
    }
    match /connections/{id} {
      allow create: if true;
      allow read: if false;
    }
    match /events/{id} {
      allow read: if true;
      allow create: if request.resource.data.status == 'pending';
      allow update: if resource.data.organizerId == request.auth.uid;
      allow delete: if resource.data.organizerId == request.auth.uid;
    }
  }
}
