rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{id} {
      allow read: if true;
      // Users can create listings but cannot set verified/verificationStatus —
      // those fields are written only by the Cloud Function (admin SDK bypasses rules)
      allow create: if true
        && !('verified' in request.resource.data)
        && !('verificationStatus' in request.resource.data);
      // Allow incrementing the views counter only
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }
    match /claims/{id} {
      allow create: if true;
    }
    match /connections/{id} {
      allow create: if true;
      allow read: if false;
    }
  }
}
